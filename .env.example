DB_URL=postgres://user:pass@localhost:5432/market_data?sslmode=disable
DB_MAX_CONNS=10
DB_MIX_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_IDLE_TIME=30m
DB_CONNECTIO_TIMEOUT=5s

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

// "postgres | redis"
QUEUE_BACKEND=postgres

// "memory | redis"
REALTIME_BACKEND=memory