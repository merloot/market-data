# Postgres.
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=market_data_go
POSTGRES_PORT=5432

# Redis.
REDIS_PORT=6379

# Приложение.
DATABASE_URL=postgres://user:pass@localhost:5432/market_data_go?sslmode=disable
