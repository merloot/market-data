# Postgres.
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=market_data_go
POSTGRES_PORT=5432

# Redis.
REDIS_PORT=6379

# Приложение.
DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
REALTIME_BACKEND=memory
QUEUE_BACKEND=redis